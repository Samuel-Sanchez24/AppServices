# Plantilla de configuración. Copia este archivo a ".env" y completa los valores.
# El archivo .env NUNCA se sube a Git (está en .gitignore); aquí no se escriben credenciales reales.

# --- PostgreSQL (host y credenciales los entrega el docente) ---
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Controlador: auto (usa psycopg y, si Windows lo bloquea, pg8000), psycopg o pg8000
DB_DRIVER=auto
# Solo si hace falta: require (conexión cifrada) o disable. Vacío = valor por defecto del controlador
DB_SSLMODE=

# --- MQTT ---
MQTT_ENABLED=true
MQTT_BROKER=emqx.coriotlab.co
MQTT_PORT=1883
# Tópico EXACTO del sensor asignado (sin comodines + ni #)
MQTT_TOPIC=iot/sensors/GAS-004/data
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60

# --- Aplicación ---
LOG_LEVEL=INFO
# Segundos de tolerancia para aceptar timestamps "del futuro" por diferencia de reloj
TIMESTAMP_TOLERANCIA_FUTURO_SEGUNDOS=600
